NODE_ENV=development
PORT=4000

# Local Postgres — matches docker-compose.yml when running via Docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forkly?schema=public"

# Generate real secrets for anything beyond local development, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin allowed to call this API with credentials
CORS_ORIGIN=http://localhost:5174

# Google Identity Services Web Client ID
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# express-rate-limit window/threshold
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
