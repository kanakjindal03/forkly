// Forkly — Prisma schema
// Normalized relational schema for the food ordering & restaurant management platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum Role {
  CUSTOMER
  RESTAURANT_OWNER
  DELIVERY_PARTNER
  ADMIN
}

enum RestaurantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DeliveryPartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  UPI
  WALLET
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FLAT
  FREE_DELIVERY
}

// =====================================================================
// CORE ENTITIES
// =====================================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  favorites       Favorite[]
  notifications   Notification[]
  restaurant      Restaurant?
  deliveryPartner DeliveryPartner?

  @@map("users")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String
  line1      String
  city       String
  state      String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

model Restaurant {
  id           String           @id @default(uuid())
  ownerId      String           @unique
  name         String
  slug         String           @unique
  description  String?
  cuisine      String
  logoUrl      String?
  bannerUrl    String?
  addressLine  String
  city         String
  latitude     Float?
  longitude    Float?
  phone        String?
  email        String?
  status       RestaurantStatus @default(PENDING)
  priceLevel   Int              @default(2)
  avgRating    Float            @default(0)
  reviewCount  Int              @default(0)
  openingHours Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  owner                User                 @relation(fields: [ownerId], references: [id])
  restaurantCategories RestaurantCategory[]
  menuCategories       MenuCategory[]
  foodItems            FoodItem[]
  orders               Order[]
  reviews              Review[]
  coupons              Coupon[]
  offers               Offer[]
  favorites            Favorite[]

  @@map("restaurants")
}

/// Global cuisine/browse taxonomy (e.g. "Pizza", "Healthy") used for filtering.
model Category {
  id   String @id @default(uuid())
  name String @unique
  icon String?

  restaurants RestaurantCategory[]

  @@map("categories")
}

model RestaurantCategory {
  restaurantId String
  categoryId   String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([restaurantId, categoryId])
  @@map("restaurant_categories")
}

/// A restaurant's own menu sections (e.g. "Pizzas", "Pasta", "Desserts").
model MenuCategory {
  id           String @id @default(uuid())
  restaurantId String
  name         String
  position     Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodItems  FoodItem[]

  @@map("menu_categories")
}

model FoodItem {
  id             String   @id @default(uuid())
  restaurantId   String
  menuCategoryId String
  name           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  isVeg          Boolean  @default(true)
  isAvailable    Boolean  @default(true)
  isPopular      Boolean  @default(false)
  calories       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuCategory MenuCategory @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)
  images       FoodImage[]
  addOns       AddOn[]
  orderItems   OrderItem[]
  favorites    Favorite[]

  @@map("food_items")
}

model FoodImage {
  id         String @id @default(uuid())
  foodItemId String
  url        String
  position   Int    @default(0)

  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@map("food_images")
}

model AddOn {
  id         String  @id @default(uuid())
  foodItemId String
  name       String
  price      Decimal @db.Decimal(10, 2)

  foodItem        FoodItem         @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  orderItemAddOns OrderItemAddOn[]

  @@map("add_ons")
}

// =====================================================================
// ORDERS & PAYMENTS
// =====================================================================

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  userId            String
  restaurantId      String
  addressId         String
  deliveryPartnerId String?
  couponId          String?
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(10, 2)
  discount          Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal     @default(0) @db.Decimal(10, 2)
  tax               Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  placedAt          DateTime    @default(now())
  deliveredAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id])
  address         Address          @relation(fields: [addressId], references: [id])
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  coupon          Coupon?          @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  payment         Payment?
  review          Review?

  @@index([userId])
  @@index([restaurantId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  foodItemId    String
  nameSnapshot  String
  priceSnapshot Decimal @db.Decimal(10, 2)
  quantity      Int

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem FoodItem         @relation(fields: [foodItemId], references: [id])
  addOns   OrderItemAddOn[]

  @@map("order_items")
}

model OrderItemAddOn {
  id            String  @id @default(uuid())
  orderItemId   String
  addOnId       String
  nameSnapshot  String
  priceSnapshot Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addOn     AddOn     @relation(fields: [addOnId], references: [id])

  @@map("order_item_add_ons")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @unique
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  transactionRef String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// =====================================================================
// REVIEWS, COUPONS & OFFERS
// =====================================================================

model Review {
  id           String   @id @default(uuid())
  userId       String
  restaurantId String
  orderId      String?  @unique
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])

  @@map("reviews")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  value         Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  minOrderValue Decimal?     @db.Decimal(10, 2)
  restaurantId  String?
  isActive      Boolean      @default(true)
  usageCount    Int          @default(0)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@map("coupons")
}

/// Marketing campaigns / banners — distinct from redeemable Coupons.
model Offer {
  id           String    @id @default(uuid())
  title        String
  description  String?
  scope        String    @default("platform")
  restaurantId String?
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  @@map("offers")
}

// =====================================================================
// DELIVERY, NOTIFICATIONS & FAVORITES
// =====================================================================

model DeliveryPartner {
  id               String                @id @default(uuid())
  userId           String                @unique
  vehicleType      String
  vehicleNumber    String?
licenseNumber    String?
  status           DeliveryPartnerStatus @default(PENDING)
  isAvailable      Boolean               @default(false)
  rating           Float                 @default(0)
  totalDeliveries  Int                   @default(0)
  currentLatitude  Float?
  currentLongitude Float?
  createdAt        DateTime              @default(now())

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@map("delivery_partners")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   @default("general")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// A favorite is either a restaurant or a food item (exactly one should be set).
model Favorite {
  id           String   @id @default(uuid())
  userId       String
  restaurantId String?
  foodItemId   String?
  createdAt    DateTime @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodItem   FoodItem?   @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId], name: "unique_user_restaurant_favorite")
  @@unique([userId, foodItemId], name: "unique_user_fooditem_favorite")
  @@map("favorites")
}
